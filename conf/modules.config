/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" }, mode: params.publish_dir_mode, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }]

    withName: SELENOPROFILES_SELENOPROFILES {
        // intron prediction is wrong for prokaryotic genomes; splicing stays on unless the domain says prokaryote
        ext.args = { meta.domain in ['bacteria', 'archaea'] ? '-no_splice' : '' }
    }

    withName: 'MINIPROT_INDEX|UNTAR_SELENOPROFILES_DATA|UNTAR_SELENOPROFILES_OVERRIDES|SELENOPROFILES_OVERRIDE' {
        publishDir = [enabled: false]
    }

    withName: SEQKIT_STATS {
        ext.prefix = { "${meta.id}" }
    }

    withName: MINIPROT_ALIGN {
        ext.args = '-I --gff'
    }

    withName: INFERNAL_CMSEARCH_SECIS {
        // with secis_min_bits, weaker hits are reported too; only included hits count as SECIS support
        ext.args = { params.secis_min_bits != null ? "-T ${params.secis_min_bits}" : '--cut_ga' }
        ext.prefix = { "${meta.id}.secis" }
    }

    withName: INFERNAL_CMSEARCH_SCREEN {
        ext.args = '--toponly -T 10'
        ext.prefix = { "${meta.id}.screen" }
    }

    withName: INFERNAL_CMSEARCH_TRNASEC {
        ext.args = '--cut_ga --rfam --nohmmonly'
        ext.prefix = { "${meta.id}.trnasec" }
    }

    withName: TRNASCANSE {
        ext.args = { [eukaryota: '-E', bacteria: '-B', archaea: '-A'][meta.domain] }
    }

    withName: 'PROFILE_QUERIES|SEC_SUMMARY' {
        publishDir = [path: { "${params.outdir}/summary" }, mode: params.publish_dir_mode]
    }

    withName: MINIMAP2_ALIGN_TRANSCRIPTS {
        // spliced alignment of transcripts or ESTs; one primary alignment per transcript is enough
        ext.args = '-x splice --secondary=no'
        ext.prefix = { "${meta.id}.transcripts" }
        publishDir = [enabled: false]
    }
    withName: SEC_TRANSCRIPT_SUPPORT {
        publishDir = [path: { "${params.outdir}/transcripts" }, mode: params.publish_dir_mode]
    }
    withName: SEC_ANNOTATION_CHECK {
        publishDir = [path: { "${params.outdir}/annotation" }, mode: params.publish_dir_mode]
    }

    withName: 'READTHROUGH_SCREEN|RANK_READTHROUGH' {
        publishDir = [path: { "${params.outdir}/readthrough" }, mode: params.publish_dir_mode]
    }

    withName: EXPECTATION_CHECK {
        ext.args = { "--lineage ${params.expectation_lineage} --copies ${params.expectation_copies}" + (params.expectation_hemizygous ? " --hemizygous ${params.expectation_hemizygous}" : '') }
        publishDir = [path: { "${params.outdir}/expectation" }, mode: params.publish_dir_mode]
    }

    withName: MULTIQC {
        ext.args = { params.multiqc_title ? "--title \"${params.multiqc_title}\"" : '' }
        publishDir = [path: { "${params.outdir}/multiqc" }, mode: params.publish_dir_mode]
    }
}
