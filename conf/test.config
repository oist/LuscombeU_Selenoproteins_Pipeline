/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run oist/LuscombeU_Selenoproteins_Pipeline -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [cpus: 4, memory: '15.GB', time: '1.h']
}

params {
    config_profile_name = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data
    // TODO Move the samplesheet and a profiles archive to a pipeline branch of nf-core/test-datasets
    input = "${projectDir}/assets/test/samplesheet_test.csv"
    // Profiles only, pinned commit; the profiles used by the test need no tag or GO data
    selenoprofiles_data = 'https://codeload.github.com/mariottigenomicslab/selenoprotein_profiles/tar.gz/4829bc969570587c222f1ce4721038fd75c804a0'
    // RF00031 scores the SECIS of human SELENOO (chr22) at 16 bits, below its gathering threshold (35 bits):
    // a lower threshold lets the test exercise the SECIS support path
    secis_min_bits = 15
}
