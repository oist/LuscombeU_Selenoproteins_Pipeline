nextflow_process {

    name "Test Process SELENOPROFILES_ASSESS"
    script "../main.nf"
    process "SELENOPROFILES_ASSESS"

    tag "modules"
    tag "modules_nfcore"
    tag "selenoprofiles"
    tag "selenoprofiles/assess"

    // TODO A real test needs a reference annotation overlapping a selenoprotein gene in nf-core/test-datasets.
    test("homo_sapiens - chr22 - gtf - gff3 - fasta - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.gtf', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.gff3', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr22/sequence/hg38.chr22.fasta', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
